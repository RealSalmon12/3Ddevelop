{
  "name": "@suite/modeler",
  "version": "0.1.0",
  "private": true,
  "description": "누구나 스튜디오 3D 모델러",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "preview": "vite",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@suite/shell": "*",
    "@suite/ui": "*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "vite": "^8.3.5"
  },
  "author": "누구나 스튜디오",
  "build": {
    "appId": "com.nugunastudio.modeler",
    "productName": "3D 모델러",
    "artifactName": "NugunaStudio-3D-Modeler-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "3D 모델러",
      "language": "1042"
    },
    "fileAssociations": [
      {
        "ext": "nmodel",
        "name": "3D 모델러 프로젝트",
        "description": "3D 모델러 프로젝트",
        "role": "Editor"
      }
    ],
    "electronVersion": "45.0.0",
    "executableName": "NugunaModeler"
  }
}
