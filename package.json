{
  "name": "3ddevelop",
  "private": true,
  "description": "초보자 친화 크리에이티브 프로그램 제품군",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:hub": "npm run dev -w @suite/hub",
    "dev:modeler": "npm run dev -w @suite/modeler",
    "dev:pixel": "npm run dev -w @suite/pixel",
    "dev:photo": "npm run dev -w @suite/photo",
    "dev:sound": "npm run dev -w @suite/sound",
    "dev:video": "npm run dev -w @suite/video",
    "build:hub": "npm run build -w @suite/hub",
    "build:modeler": "npm run build -w @suite/modeler",
    "build:pixel": "npm run build -w @suite/pixel",
    "build:photo": "npm run build -w @suite/photo",
    "build:sound": "npm run build -w @suite/sound",
    "build:video": "npm run build -w @suite/video",
    "build": "npm run build:hub && npm run build:modeler && npm run build:pixel && npm run build:photo && npm run build:sound && npm run build:video",
    "typecheck": "tsc -p packages/ui && tsc -p packages/shell && tsc -p apps/hub && tsc -p apps/modeler && tsc -p apps/pixel && tsc -p apps/photo && tsc -p apps/sound && tsc -p apps/video",
    "dist:hub": "npm run dist -w @suite/hub",
    "dist:modeler": "npm run dist -w @suite/modeler",
    "dist:pixel": "npm run dist -w @suite/pixel",
    "dist:photo": "npm run dist -w @suite/photo",
    "dist:sound": "npm run dist -w @suite/sound",
    "dist:video": "npm run dist -w @suite/video"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
